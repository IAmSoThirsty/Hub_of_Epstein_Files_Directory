# Temporary files
*.tmp
tmp/*
!tmp/.gitkeep
cache/*
!cache/.gitkeep

# Environment variables
.env
.env.local
.env.*.local

# Data files - Now tracked with Git LFS (see .gitattributes)
# Large files (PDFs, images, videos) are in LFS, metadata stays in Git
data/public_files/**/*.txt
data/processed/**/*.txt
data/wikipedia/**/*.txt
data/uncensored_files/**/*.txt
# Keep metadata and JSON files in normal Git for visibility
!data/**/*.json
!data/**/*.md
!data/**/.gitkeep

# Test coverage
htmlcov/
.coverage
.coverage.*
.pytest_cache/
coverage.xml
*.cover

# Docker
.dockerignore

# Database
*.db
*.sqlite
*.sqlite3

# Jupyter Notebooks
.ipynb_checkpoints
*.ipynb

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre
.pyre/

# macOS
.AppleDouble
.LSOverride

# Node modules (if any JS dependencies)
node_modules/

# Package files
*.tar.gz
*.zip


# Local tooling/runtime artifacts
.codacy/
.github/instructions/
data/uploads/*
!data/uploads/.gitkeep
