# =============================================================================
# Source Code - Standard Git Handling (NOT LFS)
# =============================================================================

# Ensure source code is NOT handled by LFS
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# =============================================================================
# Configuration Files - Standard Git
# =============================================================================

.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
requirements.txt text eol=lf
setup.py text eol=lf

# =============================================================================
# Directory-Specific Rules for Uncensored.ai Integration
# =============================================================================

# Track all files in uncensored_files directories with LFS
data/uncensored_files/documents/** filter=lfs diff=lfs merge=lfs -text
data/uncensored_files/images/** filter=lfs diff=lfs merge=lfs -text
data/uncensored_files/videos/** filter=lfs diff=lfs merge=lfs -text
data/uncensored_files/flight_logs/** filter=lfs diff=lfs merge=lfs -text
data/uncensored_files/financial/** filter=lfs diff=lfs merge=lfs -text

# But exclude metadata (JSON files should be in normal Git)
*.json !filter !diff !merge text

# =============================================================================
# Public Files Directories
# =============================================================================

data/public_files/** filter=lfs diff=lfs merge=lfs -text
data/processed/** filter=lfs diff=lfs merge=lfs -text

# =============================================================================
# Notes
# =============================================================================
#
# Git LFS Limits:
# - GitHub Free: 1 GB storage, 1 GB bandwidth/month
# - GitHub Pro: 50 GB storage, 50 GB bandwidth/month
# - Git LFS bandwidth: $5/50GB pack
#
# Best Practices:
# 1. All binary files > 10MB should be in LFS
# 2. Frequently changing files < 1MB can stay in normal Git
# 3. Metadata and JSON always in normal Git for diff visibility
# 4. Source code NEVER in LFS
#
# Setup:
# 1. Install Git LFS: `git lfs install`
# 2. Track files: Already configured in this file
# 3. Push: `git add .gitattributes && git commit && git push`
#
# Monolithic Density Principle:
# - All data centralized but efficiently stored
# - Large files don't bloat repository
# - Fast clones with `git lfs fetch` on demand
# - Full history preserved
#
# =============================================================================
