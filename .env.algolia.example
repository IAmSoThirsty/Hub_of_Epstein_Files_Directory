# ============================================================================
# EPSTEIN FILES HUB - ALGOLIA INTEGRATION & ANALYTICS
# Environment Configuration Template
# ============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.algolia.example .env
# 2. Fill in all required values (marked with <REQUIRED>)
# 3. Review and adjust optional values as needed
# 4. NEVER commit .env file to version control (.gitignore configured)
#
# SECURITY:
# - Keep this file secure and never expose in public repositories
# - Use strong, randomly generated secrets
# - Rotate API keys and secrets regularly (every 90 days recommended)
# - Use different credentials for dev/staging/production
#
# ============================================================================

# ============================================================================
# ENVIRONMENT AND DEPLOYMENT
# ============================================================================

# Environment name: dev, staging, prod
# Affects: logging verbosity, error handling, feature flags
ENVIRONMENT=dev

# Application name and version
APP_NAME=epstein-files-hub
APP_VERSION=1.0.0

# Debug mode (NEVER enable in production)
# Affects: detailed error messages, auto-reload, profiling
DEBUG=true

# ============================================================================
# ALGOLIA CONFIGURATION
# ============================================================================

# Algolia Application ID
# Where to find: https://dashboard.algolia.com/ → API Keys
# Format: 10-character alphanumeric string
ALGOLIA_APP_ID=<REQUIRED>

# Algolia Admin API Key (write access)
# WARNING: This key has full write access. Keep secure!
# Rotate: Every 90 days minimum
# Used by: Backend indexing pipelines only
ALGOLIA_ADMIN_API_KEY=<REQUIRED>

# Algolia Search-Only API Key (read access)
# Safe to expose in frontend code
# Used by: Web frontend, public API
ALGOLIA_SEARCH_API_KEY=<REQUIRED>

# Algolia Environment/Index Prefix
# Purpose: Separate dev/staging/prod indices
# Examples: dev, stg, prod, test
# Resulting index names: {prefix}_documents, {prefix}_characters, etc.
ALGOLIA_INDEX_PREFIX=dev

# Algolia Request Timeout (milliseconds)
# Range: 1000-120000 (1s to 2min)
# Recommendation: 30000 (30s) for indexing, 5000 (5s) for search
ALGOLIA_TIMEOUT_MS=30000

# Algolia Batch Size
# Number of records per batch operation
# Range: 1-10000
# Recommendation: 1000 for balanced throughput/memory
ALGOLIA_BATCH_SIZE=1000

# Algolia Connection Pool Size
# Number of concurrent connections to Algolia
# Range: 1-100
# Recommendation: 10 for typical workload
ALGOLIA_POOL_SIZE=10

# Algolia Replica Count
# Number of replica indices for sorting/ranking variations
# Range: 0-10
# Cost impact: Each replica counts toward record quota
ALGOLIA_REPLICA_COUNT=2

# ============================================================================
# ALGOLIA FEATURE FLAGS
# ============================================================================

# Enable Algolia Insights Analytics
# Tracks: search queries, clicks, conversions
# Cost: Included in plan, no additional charge
ALGOLIA_ENABLE_ANALYTICS=true

# Enable Personalization
# Requires: Algolia Personalization add-on
# Cost: $0.50 per 1000 requests
ALGOLIA_ENABLE_PERSONALIZATION=false

# Enable A/B Testing
# Requires: Algolia A/B Testing add-on
# Cost: Included in Premium plan
ALGOLIA_ENABLE_AB_TESTING=false

# Enable Query Suggestions
# Automatically generate search suggestions
ALGOLIA_ENABLE_SUGGESTIONS=true

# ============================================================================
# ALGOLIA RESILIENCE AND PERFORMANCE
# ============================================================================

# Enable Circuit Breaker
# Prevents cascading failures when Algolia is degraded
ALGOLIA_ENABLE_CIRCUIT_BREAKER=true

# Circuit Breaker - Failure Threshold
# Number of failures before opening circuit
ALGOLIA_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Circuit Breaker - Recovery Timeout (seconds)
# Time to wait before attempting recovery
ALGOLIA_CIRCUIT_BREAKER_TIMEOUT=60

# Rate Limiting - Requests Per Second
# Global rate limit for Algolia API calls
# Algolia limits: 10,000 indexing ops/sec, unlimited search
ALGOLIA_RATE_LIMIT_RPS=100

# Rate Limiting - Burst Size
# Maximum burst capacity (token bucket)
ALGOLIA_RATE_LIMIT_BURST=200

# Maximum Retry Attempts
# Number of retries for failed requests
ALGOLIA_MAX_RETRIES=3

# ============================================================================
# ENCRYPTION AND SECRETS
# ============================================================================

# Encryption Key for Sensitive Configuration
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate: Every 180 days
ALGOLIA_ENCRYPTION_KEY=<REQUIRED_IF_ENCRYPTING_CONFIGS>

# Application Secret Key
# Used for: JWT signing, CSRF tokens, session encryption
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Length: 64 characters minimum
SECRET_KEY=<REQUIRED>

# JWT Settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL for Analytics)
# ============================================================================

# Database Type: postgresql, sqlite
# PostgreSQL recommended for production
DATABASE_TYPE=postgresql

# PostgreSQL Connection (if DATABASE_TYPE=postgresql)
# Format: postgresql://user:password@host:port/database
# Examples:
#   Local: postgresql://postgres:postgres@localhost:5432/epstein_analytics
#   AWS RDS: postgresql://admin:password@mydb.abc123.us-east-1.rds.amazonaws.com:5432/analytics
#   Azure: postgresql://admin@myserver:password@myserver.postgres.database.azure.com:5432/analytics
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/epstein_analytics

# SQLite Connection (if DATABASE_TYPE=sqlite)
# Format: sqlite:///path/to/database.db
# Use for: Development, testing only
# SQLITE_DATABASE_URL=sqlite:///./epstein_analytics.db

# Database Connection Pool
# Min/max connections in pool
DATABASE_POOL_MIN_SIZE=5
DATABASE_POOL_MAX_SIZE=20

# Database Connection Timeout (seconds)
DATABASE_CONNECT_TIMEOUT=10

# ============================================================================
# REDIS CONFIGURATION (Caching and Rate Limiting)
# ============================================================================

# Redis URL
# Format: redis://[username:password@]host:port/database
# Examples:
#   Local: redis://localhost:6379/0
#   AWS ElastiCache: redis://:password@myredis.abc123.0001.use1.cache.amazonaws.com:6379/0
#   Azure Cache: redis://:password@myredis.redis.cache.windows.net:6380/0?ssl=true
REDIS_URL=redis://localhost:6379/0

# Redis SSL/TLS
# Enable for cloud-hosted Redis (AWS ElastiCache, Azure Cache)
REDIS_SSL=false

# Redis Connection Pool
REDIS_POOL_MAX_CONNECTIONS=50

# Redis Connection Timeout (seconds)
REDIS_CONNECT_TIMEOUT=5

# Cache TTL (seconds)
# Default time-to-live for cached items
CACHE_DEFAULT_TTL=3600

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================

# API Server Host and Port
API_HOST=0.0.0.0
API_PORT=8000

# API Workers (Uvicorn)
# Number of worker processes
# Recommendation: (2 * CPU cores) + 1
API_WORKERS=4

# API Request Timeout (seconds)
API_TIMEOUT=30

# API Rate Limiting
# Requests per minute per IP/API key
API_RATE_LIMIT_PER_MINUTE=100

# CORS Allowed Origins
# Comma-separated list of allowed origins
# Examples:
#   Development: http://localhost:3000,http://127.0.0.1:8080
#   Production: https://iamsothirsty.github.io
CORS_ALLOWED_ORIGINS=https://iamsothirsty.github.io,http://localhost:3000

# ============================================================================
# AUTHENTICATION AND AUTHORIZATION
# ============================================================================

# OAuth 2.0 Provider
# Options: auth0, keycloak, custom
OAUTH_PROVIDER=auth0

# Auth0 Configuration (if OAUTH_PROVIDER=auth0)
AUTH0_DOMAIN=<YOUR_DOMAIN>.auth0.com
AUTH0_CLIENT_ID=<REQUIRED_IF_USING_AUTH0>
AUTH0_CLIENT_SECRET=<REQUIRED_IF_USING_AUTH0>
AUTH0_AUDIENCE=https://api.epstein-files.com

# Keycloak Configuration (if OAUTH_PROVIDER=keycloak)
# KEYCLOAK_URL=https://keycloak.example.com
# KEYCLOAK_REALM=epstein-files
# KEYCLOAK_CLIENT_ID=api-client
# KEYCLOAK_CLIENT_SECRET=<SECRET>

# ============================================================================
# MONITORING AND OBSERVABILITY
# ============================================================================

# Enable Prometheus Metrics
ENABLE_METRICS=true

# Prometheus Metrics Port
METRICS_PORT=9090

# Enable Distributed Tracing
ENABLE_TRACING=true

# Jaeger Configuration
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLER_PARAM=0.01

# Sentry Configuration
# DSN from: https://sentry.io/ → Project Settings → Client Keys (DSN)
SENTRY_DSN=<OPTIONAL>
SENTRY_ENVIRONMENT=${ENVIRONMENT}
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================================================
# ANALYTICS CONFIGURATION
# ============================================================================

# Enable Analytics Collection
ENABLE_ANALYTICS=true

# Analytics Data Retention (days)
# How long to keep raw analytics events
ANALYTICS_RETENTION_DAYS=365

# Analytics Aggregation Interval (minutes)
# How often to aggregate raw events into summaries
ANALYTICS_AGGREGATION_INTERVAL=60

# Analytics Export Formats
# Comma-separated: csv, json, parquet
ANALYTICS_EXPORT_FORMATS=csv,json

# ============================================================================
# BACKGROUND TASKS AND SCHEDULING
# ============================================================================

# Task Queue Backend
# Options: redis, rabbitmq, sqs
TASK_QUEUE_BACKEND=redis

# Celery Broker URL (if using Celery)
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# Scheduled Tasks
# Cron-style schedules for background jobs

# Algolia Index Sync Schedule
# Format: minute hour day month day_of_week
# Example: "0 2 * * *" = 2:00 AM daily
INDEX_SYNC_SCHEDULE=0 2 * * *

# Analytics Aggregation Schedule
# Example: "0 * * * *" = Every hour
ANALYTICS_AGGREGATION_SCHEDULE=0 * * * *

# ============================================================================
# CLOUD PLATFORM CONFIGURATION
# ============================================================================

# Cloud Provider: aws, azure, gcp, none
CLOUD_PROVIDER=none

# AWS Configuration (if CLOUD_PROVIDER=aws)
# AWS_ACCESS_KEY_ID=<REQUIRED_IF_USING_AWS>
# AWS_SECRET_ACCESS_KEY=<REQUIRED_IF_USING_AWS>
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=epstein-files-data

# Azure Configuration (if CLOUD_PROVIDER=azure)
# AZURE_SUBSCRIPTION_ID=<REQUIRED_IF_USING_AZURE>
# AZURE_TENANT_ID=<REQUIRED_IF_USING_AZURE>
# AZURE_CLIENT_ID=<REQUIRED_IF_USING_AZURE>
# AZURE_CLIENT_SECRET=<REQUIRED_IF_USING_AZURE>
# AZURE_STORAGE_ACCOUNT=epsteinfiles
# AZURE_STORAGE_CONTAINER=data

# ============================================================================
# DEVELOPMENT AND TESTING
# ============================================================================

# Dry Run Mode
# When enabled, operations are simulated but not executed
# Use for: Testing, validation, cost estimation
DRY_RUN=false

# Test Mode
# Enables test-specific behaviors and mock data
TEST_MODE=false

# Test Database URL (for pytest)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/epstein_analytics_test

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Thread Pool Size
# For CPU-bound tasks
THREAD_POOL_SIZE=10

# Process Pool Size
# For parallel processing
PROCESS_POOL_SIZE=4

# Max Concurrent Requests
MAX_CONCURRENT_REQUESTS=100

# Request Queue Size
REQUEST_QUEUE_SIZE=1000

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable specific features for gradual rollout
FEATURE_FLAG_ADVANCED_SEARCH=true
FEATURE_FLAG_ANALYTICS_DASHBOARD=true
FEATURE_FLAG_EXPORT_API=true
FEATURE_FLAG_ADMIN_PANEL=true
FEATURE_FLAG_REAL_TIME_UPDATES=false

# ============================================================================
# COST OPTIMIZATION
# ============================================================================

# Enable cost optimization features
ENABLE_COST_OPTIMIZATION=true

# Cache Aggressive Mode
# More aggressive caching to reduce API calls
CACHE_AGGRESSIVE=true

# Batch Operations
# Batch multiple operations to reduce API calls
ENABLE_BATCHING=true

# ============================================================================
# COMPLIANCE AND LEGAL
# ============================================================================

# Data Privacy Settings
ENABLE_GDPR_COMPLIANCE=true
ENABLE_CCPA_COMPLIANCE=true

# Data Retention Policy (days)
USER_DATA_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=2555

# Cookie Consent
REQUIRE_COOKIE_CONSENT=true

# ============================================================================
# NOTIFICATION AND ALERTING
# ============================================================================

# Email Configuration (for alerts and notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<OPTIONAL>
SMTP_PASSWORD=<OPTIONAL>
SMTP_FROM_EMAIL=noreply@epstein-files.com

# Slack Webhook (for alerts)
SLACK_WEBHOOK_URL=<OPTIONAL>

# PagerDuty Integration Key
PAGERDUTY_INTEGRATION_KEY=<OPTIONAL>

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
