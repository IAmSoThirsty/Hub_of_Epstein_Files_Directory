# Environment Configuration for Epstein Files Hub
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# GitHub Configuration (for staff portal)
# ============================================

# GitHub OAuth App credentials
# Get these from: https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_OAUTH_CALLBACK_URL=https://iamsothirsty.github.io/Hub_of_Epstein_Files_Directory/staff/callback

# Repository settings
GITHUB_REPO_OWNER=IAmSoThirsty
GITHUB_REPO_NAME=Hub_of_Epstein_Files_Directory

# ============================================
# Application Settings
# ============================================

# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Data directories
DATA_DIR=./data
PROCESSED_DIR=./data/processed
PUBLIC_FILES_DIR=./data/public_files
WIKIPEDIA_DIR=./data/wikipedia

# ============================================
# Web Settings
# ============================================

# Base URL for GitHub Pages deployment
BASE_URL=https://iamsothirsty.github.io/Hub_of_Epstein_Files_Directory

# Local development server port
DEV_SERVER_PORT=8080

# ============================================
# API Settings (if needed)
# ============================================

# Rate limiting
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_PERIOD=60

# Timeouts (seconds)
REQUEST_TIMEOUT=30
DOWNLOAD_TIMEOUT=300

# ============================================
# Processing Settings
# ============================================

# PDF processing
OCR_ENABLED=true
OCR_LANGUAGE=eng
MAX_PDF_SIZE_MB=100

# Search index
SEARCH_INDEX_UPDATE_FREQUENCY=weekly
MAX_SEARCH_RESULTS=100

# ============================================
# Source Monitoring
# ============================================

# FBI Vault
FBI_VAULT_ENABLED=true
FBI_VAULT_UPDATE_FREQUENCY=monthly

# Wikipedia
WIKIPEDIA_ENABLED=true
WIKIPEDIA_UPDATE_FREQUENCY=weekly

# Safe source expansion
SOURCE_DISCOVERY_ENABLED=true
SOURCE_DISCOVERY_FREQUENCY=daily
AUTO_APPROVE_SOURCES=false

# ============================================
# Docker Settings
# ============================================

# Compose project name
COMPOSE_PROJECT_NAME=epstein-files-hub

# User ID for volume permissions
USER_ID=1000
GROUP_ID=1000

# ============================================
# Optional: Advanced Settings
# ============================================

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=3600

# Debug mode
DEBUG=false

# Performance monitoring
ENABLE_METRICS=false

# Sentry error tracking (optional)
# SENTRY_DSN=your_sentry_dsn_here

# ============================================
# Notes
# ============================================
# 
# 1. This is a template file. Copy to .env and customize
# 2. Never commit .env to version control
# 3. Keep sensitive credentials secure
# 4. Update values based on your deployment environment
# 5. See SETUP_GUIDE.md for detailed configuration instructions
