# Environment Configuration for Epstein Files Hub
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# GitHub Configuration (for staff portal)
# ============================================

# GitHub OAuth App credentials
# Get these from: https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_OAUTH_CALLBACK_URL=https://iamsothirsty.github.io/Hub_of_Epstein_Files_Directory/staff/callback

# Repository settings
GITHUB_REPO_OWNER=IAmSoThirsty
GITHUB_REPO_NAME=Hub_of_Epstein_Files_Directory

# ============================================
# Application Settings
# ============================================

# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Data directories
DATA_DIR=./data
PROCESSED_DIR=./data/processed
PUBLIC_FILES_DIR=./data/public_files
WIKIPEDIA_DIR=./data/wikipedia

# ============================================
# Web Settings
# ============================================

# Base URL for GitHub Pages deployment
BASE_URL=https://iamsothirsty.github.io/Hub_of_Epstein_Files_Directory

# Local development server port
DEV_SERVER_PORT=8080

# ============================================
# API Settings (if needed)
# ============================================

# Rate limiting
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_PERIOD=60

# API backend
ADMIN_API_TOKEN=change-me-dev-token
# Optional token rotation list (comma-separated). ADMIN_API_TOKEN is also accepted.
# Example: ADMIN_API_TOKENS=token1,token2
ADMIN_API_TOKENS=
# Session cookie signing (set strong non-default secret in staging/production)
ADMIN_SESSION_SECRET=change-me-dev-session-secret
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_SESSION_COOKIE_NAME=epstein_admin_session
# In production/staging this should be true (HTTPS only)
ADMIN_SESSION_COOKIE_SECURE=false
# Authentication throttling for admin endpoints
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_BACKEND=memory
AUTH_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
AUTH_RATE_LIMIT_REDIS_PREFIX=epstein_auth_rl
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:8000
SEARCH_INDEX_JS_PATH=./web/js/search-index.js
SEARCH_INDEX_JSON_PATH=./web/data/search-index.json
UPLOAD_DIR=./data/uploads
ENABLE_UPLOAD_QUARANTINE=true
UPLOAD_QUARANTINE_DIR=./data/uploads/quarantine
ENABLE_MALWARE_SCAN=false
# Example command: clamscan --no-summary --infected {file}
MALWARE_SCAN_COMMAND=
MALWARE_SCAN_TIMEOUT_SECONDS=30
MALWARE_SCAN_FAIL_CLOSED=false
MALWARE_SCAN_INFECTED_EXIT_CODES=1

# Timeouts (seconds)
REQUEST_TIMEOUT=30
DOWNLOAD_TIMEOUT=300

# ============================================
# Processing Settings
# ============================================

# PDF processing
OCR_ENABLED=true
OCR_LANGUAGE=eng
MAX_PDF_SIZE_MB=100

# Search index
SEARCH_INDEX_UPDATE_FREQUENCY=weekly
MAX_SEARCH_RESULTS=100

# ============================================
# Source Monitoring
# ============================================

# FBI Vault
FBI_VAULT_ENABLED=true
FBI_VAULT_UPDATE_FREQUENCY=monthly

# Wikipedia
WIKIPEDIA_ENABLED=true
WIKIPEDIA_UPDATE_FREQUENCY=weekly

# Uncensored.ai Integration
UNCENSORED_AI_ENABLED=true
UNCENSORED_AI_BASE_URL=https://api.uncensored.ai/v1
UNCENSORED_AI_API_KEY=
UNCENSORED_AI_RATE_LIMIT=2
UNCENSORED_AI_UPDATE_FREQUENCY=daily
UNCENSORED_FILES_DIR=./data/uncensored_files

# Safe source expansion
SOURCE_DISCOVERY_ENABLED=true
SOURCE_DISCOVERY_FREQUENCY=daily
AUTO_APPROVE_SOURCES=false

# ============================================
# Docker Settings
# ============================================

# Compose project name
COMPOSE_PROJECT_NAME=epstein-files-hub

# User ID for volume permissions
USER_ID=1000
GROUP_ID=1000

# ============================================
# Optional: Advanced Settings
# ============================================

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=3600

# Debug mode
DEBUG=false

# Performance monitoring
ENABLE_METRICS=false

# Sentry error tracking (optional)
# SENTRY_DSN=your_sentry_dsn_here

# ============================================
# Notes
# ============================================
# 
# 1. This is a template file. Copy to .env and customize
# 2. Never commit .env to version control
# 3. Keep sensitive credentials secure
# 4. Update values based on your deployment environment
# 5. See SETUP_GUIDE.md for detailed configuration instructions
